{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onaka-log:llm:text-estimate:output:v0.1",
  "title": "TextEstimateOutput",
  "description": "食べたものの説明文から推定した結果。合計値は出力させず、コード側で items から計算する。",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "meal_name", "items", "assumptions", "notes"],
  "properties": {
    "status": {
      "description": "ok: 推定できた / not_food: 食べ物の説明ではない / ambiguous: 内容があいまいで推定できない",
      "type": "string",
      "enum": ["ok", "not_food", "ambiguous"]
    },
    "meal_name": {
      "type": ["string", "null"]
    },
    "items": {
      "description": "説明に含まれる料理・食品ごとの推定。status が ok 以外なら空配列",
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "assumptions": {
      "description": "推定の前提（例: 「量の記載がないため一般的な1人前と仮定」）",
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "amount", "estimated_weight_g", "nutrients", "confidence"],
      "properties": {
        "name": { "type": "string" },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": { "type": "number", "minimum": 0 },
            "unit": { "type": "string", "enum": ["g", "ml", "piece", "serving", "bowl", "cup", "slice"] }
          }
        },
        "estimated_weight_g": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "nutrients": { "$ref": "#/$defs/nutrients" },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    },
    "nutrients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["energy_kcal", "protein_g", "fat_g", "carbohydrate_g"],
      "properties": {
        "energy_kcal": { "type": "number", "minimum": 0 },
        "protein_g": { "type": "number", "minimum": 0 },
        "fat_g": { "type": "number", "minimum": 0 },
        "carbohydrate_g": { "type": "number", "minimum": 0 }
      }
    }
  }
}
