{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:onaka-log:llm:text-estimate:input:v0.1",
  "title": "TextEstimateInput",
  "description": "推定モジュールへの入力。ユーザーが入力した食事の説明文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "locale"],
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "locale": { "type": "string", "enum": ["ja-JP"] }
  }
}
